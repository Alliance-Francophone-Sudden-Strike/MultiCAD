/* UTF-8 resource script for the MinGW build. The upstream src/MultiCAD.rc is
 * UTF-16 and pulls in winres.h; this reproduces the same VS_VERSION_INFO
 * payload with the version taken from src/core/version.h. Compiled with windres. */
#include <windows.h>
#include "version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    MULTICAD_VERSION_MAJOR,MULTICAD_VERSION_MINOR,MULTICAD_VERSION_PATCH,0
 PRODUCTVERSION MULTICAD_VERSION_MAJOR,MULTICAD_VERSION_MINOR,MULTICAD_VERSION_PATCH,0
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         0x40004L
 FILETYPE       0x2L
 FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041904b0"
        BEGIN
            VALUE "FileDescription",  "MultiCAD dll for Sudden Strike"
            VALUE "FileVersion",      MULTICAD_VERSION_STR
            VALUE "InternalName",     "MultiCAD.dll"
            VALUE "LegalCopyright",   "Copyright (C) 2025"
            VALUE "OriginalFilename", "cadMulti.dll"
            VALUE "ProductName",      "MultiCAD"
            VALUE "ProductVersion",   MULTICAD_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x419, 1200
    END
END
